# Telegram (from https://my.telegram.org)
TG_API_ID=
TG_API_HASH=

# Negative number starting -100, find it by running login.py
CHANNEL_ID=

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number, with + and country code, e.g. +15551234567
TWILIO_FROM=
# Your mobile, with + and country code, e.g. +919876543210
TWILIO_TO=

# Minutes to ignore new messages after a call is placed
COOLDOWN_MINUTES=3

# Set to 1 to log what would be dialed instead of actually calling
DRY_RUN=0
